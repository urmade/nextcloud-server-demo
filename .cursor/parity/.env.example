#
# Copy to .env before booting: cp .env.example .env
# Test-only placeholders — do not use real secrets or production values.

# URL the parity harness uses to reach legacy Nextcloud (host or CI runner).
LEGACY_BASE_URL=http://localhost:19080

# Admin account created on first container start.
LEGACY_ADMIN_USER=admin
LEGACY_ADMIN_PASSWORD=parity-test-password

# Host port published by docker compose (container listens on 80).
LEGACY_HTTP_PORT=19080

# Official Nextcloud server image tag (separate from the in-repo Next.js refactor).
NEXTCLOUD_IMAGE=nextcloud:stable
